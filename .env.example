# note の RSS フィード URL（読み取り専用。note への投稿は自動化しない）
NOTE_RSS_URL=https://note.com/fast_lily4472/rss

# Claude API キー（投稿文の生成と、アイキャッチ画像の読み取り・選定に使用）
ANTHROPIC_API_KEY=

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Threads API
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- アイキャッチ画像の探索先 -----------------------------------------------

# ローカルの画像フォルダ（サブフォルダも再帰的に探す）
LOCAL_IMAGE_FOLDER=

# Google ドライブのフォルダ ID（フォルダURLの /folders/ の後ろの文字列）
GDRIVE_FOLDER_ID=

# Google サービスアカウントの鍵。JSON ファイルのパス、または JSON 文字列そのもの。
# GitHub Secrets に入れる場合は JSON 文字列をそのまま貼る。
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- 画像の公開URL ----------------------------------------------------------

# Instagram はテキストのみの投稿ができず、画像は「公開URL」でしか渡せない。
# 既定画像（assets/default_post_image.png）を公開した URL を指定する。
# 例: https://raw.githubusercontent.com/<user>/<repo>/main/assets/default_post_image.png
IG_IMAGE_URL=

# ローカルフォルダの画像をそのまま投稿したい場合、その公開先のベースURL。
# 「このURL + / + ファイル名」で画像に到達できる必要がある。
# 例: https://raw.githubusercontent.com/<user>/<repo>/main/images
IMAGE_PUBLIC_BASE_URL=

# --- 任意設定 ---------------------------------------------------------------

# 投稿文生成・画像読み取りに使う Claude のモデル
ANTHROPIC_MODEL=claude-sonnet-5

# 生成された3案のうち何番目を使うか（0 / 1 / 2）
CAPTION_VARIANT_INDEX=0

# 1回の実行で投稿する最大件数（連投防止）
MAX_POSTS_PER_RUN=3

# Threads にも画像を添付するか（既定はテキストのみ投稿）
THREADS_ATTACH_IMAGE=false

# 状態ファイルとログファイルのパス（リポジトリルートからの相対パス）
POSTED_ARTICLES_PATH=posted_articles.json
LOG_FILE_PATH=logs/auto_post.log

# true にすると実際には投稿せず、生成結果のログだけ出す
DRY_RUN=false

# dry-run 中の Claude API 結果を貯めるキャッシュ（テスト時の課金を防ぐ）
DRYRUN_CACHE_PATH=.dryrun_cache.json
